local PREFS_FILE = "KodaHub_Prefs.json"

local PrefDefaults = {
    Theme = "Cobalt",
    Language = "English",
    Toasts = true,
    MenuKey = "RightControl",
    LastGame = "",
}

local function LoadPrefs()
    local Prefs = {}

    for k, v in pairs(PrefDefaults) do
        Prefs[k] = v
    end

    pcall(function()
        if isfile and readfile and isfile(PREFS_FILE) then
            local Data = HttpService:JSONDecode(readfile(PREFS_FILE))

            for k in pairs(PrefDefaults) do
                if Data[k] ~= nil then
                    Prefs[k] = Data[k]
                end
            end
        end
    end)

    return Prefs
end

local Prefs = Env.KodaPrefs or LoadPrefs()
Env.KodaPrefs = Prefs

local function SavePrefs()
    pcall(function()
        if writefile then
            writefile(PREFS_FILE, HttpService:JSONEncode(Prefs))
        end
    end)
end

-- Per-game settings live here, so switching away and back keeps them.
Env.KodaStore = Env.KodaStore or {}

local function GetStore(Key, Defaults)
    local Store = Env.KodaStore[Key]

    if not Store then
        Store = {}
        Env.KodaStore[Key] = Store
    end

    for k, v in pairs(Defaults) do
        if Store[k] == nil then
            Store[k] = v
        end
    end

    return Store
end

--==================================================
-- SESSION  (tracks everything a game creates, so unloading is complete)
--==================================================

local Session = {}
Session.__index = Session

local function NewSession()
    return setmetatable({ Conns = {}, Cleanups = {}, Dead = false }, Session)
end

function Session:Connect(Signal, Fn)
    local Conn = Signal:Connect(Fn)
    table.insert(self.Conns, Conn)
    return Conn
end

function Session:OnCleanup(Fn)
    table.insert(self.Cleanups, Fn)
end

function Session:Destroy()
    if self.Dead then
        return
    end

    self.Dead = true

    for _, Conn in ipairs(self.Conns) do
        pcall(function() Conn:Disconnect() end)
    end

    table.clear(self.Conns)

    for i = #self.Cleanups, 1, -1 do
        pcall(self.Cleanups[i])
    end

    table.clear(self.Cleanups)
end

