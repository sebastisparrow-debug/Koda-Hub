local function Teardown()
    if Active then
        local Current = Active
        Active = nil

        pcall(function() Current.Session:Destroy() end)

        pcall(function()
            if not Current.Window.unloaded then
                Current.Window:Unload()
            end
        end)
    end

    if SelectorWindow then
        local Old = SelectorWindow
        SelectorWindow = nil
        pcall(function() Old:Unload() end)
    end
end

