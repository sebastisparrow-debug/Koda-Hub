    BuildHome(Window, HomeTab, {
        Welcome = "Pick a game on the Games page. Koda Hub opens that game's menu, and Switch Game brings you back here without restarting.",
    })

    BuildSettings(Window, SettingsTab, { InGame = false })

    GamesTab:Select(true)
end

--==================================================
-- FLOW
--==================================================

LaunchGame = function(Game, SkipCheck)
    if Busy then
        return
    end

    local Ok, Reason = Game.Check()

    if not Ok and not SkipCheck then
        local Host = (Active and Active.Window) or SelectorWindow

        if Host then
            pcall(function()
                Host:Popup({
                    title = Game.Name .. " may not work here",
                    content = Reason or "This game does not look supported.",
                    options = {
                        { text = "Cancel" },
                        { text = "Load anyway", style = "danger", callback = function() LaunchGame(Game, true) end },
                    },
                })
            end)
        end

        return
    end

    Busy = true

    task.spawn(function()
        Teardown()
        task.wait(0.25)

        local BuildOk, Err = pcall(BuildGame, Game)

        if not BuildOk then
            warn("[Koda Hub] Failed to load " .. Game.Name .. ": " .. tostring(Err))

            Teardown() -- removes whatever the failed build already created
            task.wait(0.25)
            OpenSelector()

            pcall(function()
                SelectorWindow:Notify({
                    title = "Koda Hub",
                    content = Game.Name .. " failed to load. Details are in the console (F9).",
                })
            end)
        end

        Busy = false
    end)
end

UnloadToSelector = function()
    if Busy then
        return
    end

    Busy = true

    task.spawn(function()
        Teardown()
        task.wait(0.25)
        OpenSelector()
        Busy = false
    end)
end

-- Opens a picker of the other games; Games with no argument shows the popup.
SwitchTo = function(Game)
    if Game then
        LaunchGame(Game, false)
        return
    end

    if not Active then
        return
    end

    local Options = { { text = "Cancel" } }

    for _, Other in ipairs(Games) do
        if Other.Id ~= Active.Game.Id then
            table.insert(Options, {
                text = Other.Name,
                style = "primary",
                callback = function() LaunchGame(Other, false) end,
            })
        end
    end

    pcall(function()
        Active.Window:Popup({
            title = "Switch game",
            content = "Pick a game. The current one is unloaded first and your settings are kept.",
            options = Options,
        })
    end)
end

ExitHub = function()
    if Env.KodaHubCleanup ~= ExitHub then
        return
    end

    Env.KodaHubCleanup = nil
    Busy = true
    Teardown()
end

Env.KodaHubCleanup = ExitHub

OpenSelector()
