    local function UpdateEntry(Model, Entry, Origin)
        local Humanoid = Model:FindFirstChildOfClass("Humanoid")
        local Root = Model:FindFirstChild("HumanoidRootPart") or Model.PrimaryPart

        if not Humanoid or Humanoid.Health <= 0 or not Root then
            Entry.Highlight.Enabled = false
            Entry.Billboard.Enabled = false
            return
        end

        local Dist = (Root.Position - Origin).Magnitude
        local Color = ESPColor(Model)

        Entry.Highlight.Adornee = Model
        Entry.Highlight.FillColor = Color
        Entry.Highlight.OutlineColor = Color
        Entry.Highlight.Enabled = Cfg.Chams

        local Lines = {}

        if Cfg.Names then
            local Owner = Players:GetPlayerFromCharacter(Model)
            table.insert(Lines, Owner and Owner.DisplayName or Model.Name)
        end

        local Info = {}

        if Cfg.Distance then
            table.insert(Info, string.format("%d studs", Dist))
        end

        if Cfg.Health then
            table.insert(Info, string.format("%d HP", math.max(0, math.floor(Humanoid.Health))))
        end

        if #Info > 0 then
            table.insert(Lines, table.concat(Info, "  |  "))
        end

        if #Lines == 0 then
            Entry.Billboard.Enabled = false
            return
        end

        local Head = Model:FindFirstChild("Head")
        Entry.Billboard.Adornee = Head or Root
        Entry.Billboard.StudsOffset = Vector3.new(0, Head and 2.2 or 4.2, 0)
        Entry.Label.Text = table.concat(Lines, "\n")
