local PlayerCleanup
local ResetPlayerSettings

do
    local PlayerDefaults = {
        Speed = false,
        WalkSpeed = 32,
        Fly = false,
        FlySpeed = 60,
        Noclip = false,
        ThirdPerson = false,
        CameraDistance = 15,
        ScrollZoom = true,
        FlyKey = Enum.KeyCode.F,
        NoclipKey = Enum.KeyCode.N,
        ThirdPersonKey = Enum.KeyCode.V,
    }

    local PlayerSettings = {}

    for key, value in pairs(PlayerDefaults) do
        PlayerSettings[key] = value
    end

    local PlayerControls = {}
    local PlayerCleaned = false

    local SavedWalkSpeed = nil
    local FlyMover = nil          -- { Velocity, Gyro, Root }
    local NoclipParts = {}        -- parts we switched CanCollide off on
    local SavedCamera = nil       -- { Mode, Min, Max }
    local PendingZoom = true      -- snap the camera to the chosen distance once

    local function GetHumanoid()
        local Character = LocalPlayer.Character
        return Character and Character:FindFirstChildOfClass("Humanoid")
    end

    local function GetRoot()
        local Character = LocalPlayer.Character
        return Character and Character:FindFirstChild("HumanoidRootPart")
    end

    local function Down(Key)
        return UserInputService:IsKeyDown(Key)
    end

    ------------------------------ Speed
    -- Re-applied every frame because many games keep resetting WalkSpeed.
    local function UpdateSpeed()
        local Humanoid = GetHumanoid()

        if not Humanoid then
            return
        end

        if PlayerSettings.Speed then
            if SavedWalkSpeed == nil then
                SavedWalkSpeed = Humanoid.WalkSpeed
            end

            Humanoid.WalkSpeed = PlayerSettings.WalkSpeed
        elseif SavedWalkSpeed ~= nil then
            Humanoid.WalkSpeed = SavedWalkSpeed
            SavedWalkSpeed = nil
        end
    end

    ------------------------------ Flight
    local function StopFly()
        if FlyMover then
            pcall(function()
                FlyMover.Velocity:Destroy()
            end)

            pcall(function()
                FlyMover.Gyro:Destroy()
            end)

            FlyMover = nil
        end

        local Humanoid = GetHumanoid()

        if Humanoid then
            Humanoid.PlatformStand = false
        end
    end

    -- WASD to move relative to the camera, Space / E to go up, Left Ctrl / Q to go down.
    local function UpdateFly()
        if not PlayerSettings.Fly then
            if FlyMover then
                StopFly()
            end

            return
        end

        local Root = GetRoot()
        local Humanoid = GetHumanoid()
        local Camera = Workspace.CurrentCamera

        if not Root or not Humanoid or not Camera or Humanoid.Health <= 0 then
            return
        end

        -- (re)build the movers after a respawn
        if not FlyMover or FlyMover.Root ~= Root or not FlyMover.Velocity.Parent then
            if FlyMover then
                StopFly()
            end

            local Velocity = Instance.new("BodyVelocity")
            Velocity.Name = "KodaFlyVelocity"
            Velocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
            Velocity.Velocity = Vector3.new(0, 0, 0)
            Velocity.Parent = Root

            local Gyro = Instance.new("BodyGyro")
            Gyro.Name = "KodaFlyGyro"
            Gyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
            Gyro.P = 9e4
            Gyro.CFrame = Root.CFrame
            Gyro.Parent = Root

            FlyMover = { Velocity = Velocity, Gyro = Gyro, Root = Root }
        end

        Humanoid.PlatformStand = true

        local CameraCFrame = Camera.CFrame
        local Direction = Vector3.new(0, 0, 0)

        if not UserInputService:GetFocusedTextBox() then
            if Down(Enum.KeyCode.W) then
                Direction = Direction + CameraCFrame.LookVector
            end

            if Down(Enum.KeyCode.S) then
                Direction = Direction - CameraCFrame.LookVector
            end

            if Down(Enum.KeyCode.D) then
                Direction = Direction + CameraCFrame.RightVector
            end

            if Down(Enum.KeyCode.A) then
                Direction = Direction - CameraCFrame.RightVector
            end

            if Down(Enum.KeyCode.Space) or Down(Enum.KeyCode.E) then
                Direction = Direction + Vector3.new(0, 1, 0)
            end

            if Down(Enum.KeyCode.LeftControl) or Down(Enum.KeyCode.Q) then
                Direction = Direction - Vector3.new(0, 1, 0)
            end
        end

        if Direction.Magnitude > 0 then
            Direction = Direction.Unit * PlayerSettings.FlySpeed
        end

        FlyMover.Velocity.Velocity = Direction
        FlyMover.Gyro.CFrame = CFrame.lookAt(Root.Position, Root.Position + CameraCFrame.LookVector)
    end

    ------------------------------ Noclip
    local function RestoreNoclip()
        for Part in pairs(NoclipParts) do
            if Part.Parent then
                Part.CanCollide = true
            end

            NoclipParts[Part] = nil
        end
    end

    -- Runs on Stepped so it lands before physics each frame.
    local function UpdateNoclip()
        if not PlayerSettings.Noclip then
            if next(NoclipParts) then
                RestoreNoclip()
            end

            return
        end

        local Character = LocalPlayer.Character

        if not Character then
            return
        end

        for _, Part in ipairs(Character:GetDescendants()) do
            if Part:IsA("BasePart") and Part.CanCollide then
                NoclipParts[Part] = true
                Part.CanCollide = false
            end
        end
    end

    ------------------------------ Third person
    local function UpdateCamera()
        if PlayerSettings.ThirdPerson then
            if not SavedCamera then
                SavedCamera = {
                    Mode = LocalPlayer.CameraMode,
                    Min = LocalPlayer.CameraMinZoomDistance,
                    Max = LocalPlayer.CameraMaxZoomDistance,
                }
            end

            LocalPlayer.CameraMode = Enum.CameraMode.Classic

            if PendingZoom or not PlayerSettings.ScrollZoom then
                -- pin min = max = distance so the camera snaps out of first person
                LocalPlayer.CameraMinZoomDistance = PlayerSettings.CameraDistance
                LocalPlayer.CameraMaxZoomDistance = PlayerSettings.CameraDistance
                PendingZoom = false
            else
                -- then let the player scroll freely
                LocalPlayer.CameraMinZoomDistance = 0.5
                LocalPlayer.CameraMaxZoomDistance = math.max(400, PlayerSettings.CameraDistance)
            end
        elseif SavedCamera then
            LocalPlayer.CameraMode = SavedCamera.Mode
            LocalPlayer.CameraMinZoomDistance = SavedCamera.Min
            LocalPlayer.CameraMaxZoomDistance = SavedCamera.Max
            SavedCamera = nil
        end
    end

    ------------------------------ Loops
    table.insert(Connections, RunService.Heartbeat:Connect(function()
        if PlayerCleaned then
            return
        end

        UpdateSpeed()
        UpdateFly()
        UpdateCamera()
    end))

    table.insert(Connections, RunService.Stepped:Connect(function()
        if not PlayerCleaned then
            UpdateNoclip()
        end
    end))

    -- Puts everything back the way the game had it (called from Cleanup).
    PlayerCleanup = function()
        PlayerCleaned = true

        PlayerSettings.Speed = false
        PlayerSettings.Fly = false
        PlayerSettings.Noclip = false
        PlayerSettings.ThirdPerson = false

        pcall(UpdateSpeed)
        pcall(StopFly)
        pcall(RestoreNoclip)
        pcall(UpdateCamera)
    end

    ------------------------------ UI
    local function PlayerToggle(Key, Name, Description, DontSave, Announce)
        PlayerControls[Key] = PlayerTab:CreateToggle({
            name = Name,
            description = Description,
            flag = "Player_" .. Key,
            value = PlayerSettings[Key],
            forgetState = DontSave == true,

            callback = function(Value)
                local Changed = Value ~= PlayerSettings[Key]
                PlayerSettings[Key] = Value

                if Key == "ThirdPerson" or Key == "ScrollZoom" then
                    PendingZoom = true
                end

                if Changed and Announce then
                    Toast(Announce, Value and "Enabled" or "Disabled")
                end
            end,
        })
    end

    local function PlayerSlider(Key, Name, Description, Range, Increment, Suffix)
        PlayerControls[Key] = PlayerTab:CreateSlider({
            name = Name,
            description = Description,
            flag = "Player_" .. Key,
            range = Range,
            increment = Increment,
            suffix = Suffix,
            value = PlayerSettings[Key],

            callback = function(Value)
                PlayerSettings[Key] = Value

                if Key == "CameraDistance" then
                    PendingZoom = true
                end
            end,
        })
    end

    -- A keybind that flips one of the toggles above.
    local function PlayerKeybind(Key, Name, TargetToggle)
        PlayerControls[Key] = PlayerTab:CreateKeybind({
            name = Name,
            flag = "Player_" .. Key,
            value = PlayerSettings[Key],

            callback = function()
                local Control = PlayerControls[TargetToggle]

                if Control then
                    Control:Set(not PlayerSettings[TargetToggle])
                end
            end,

            onChanged = function(NewKey)
                PlayerSettings[Key] = NewKey
            end,
        })
    end

    PlayerTab:CreateSection({ name = "Movement" })
    PlayerToggle("Speed", "Speed Boost", "Overrides your WalkSpeed. Always starts off.", true, "Speed")
    PlayerSlider("WalkSpeed", "Walk Speed", "Default Roblox speed is 16.", { 16, 250 }, 1, "")
    PlayerToggle("Fly", "Flight", "WASD to move, Space / E up, Left Ctrl / Q down. Always starts off.", true, "Flight")
    PlayerSlider("FlySpeed", "Flight Speed", nil, { 10, 300 }, 5, "")
    PlayerToggle("Noclip", "Noclip", "Walk through walls. Turn on Flight too, or you will fall through the floor.", true, "Noclip")

    PlayerTab:CreateSection({ name = "Camera" })
    PlayerToggle("ThirdPerson", "Third Person", "Forces the normal chase camera, even in first-person games.", false, "Third Person")
    PlayerSlider("CameraDistance", "Camera Distance", "How far behind you the camera sits.", { 5, 100 }, 1, " studs")
    PlayerToggle("ScrollZoom", "Allow Scroll Zoom", "On: scroll to zoom after the camera snaps out. Off: distance is locked.")

    PlayerTab:CreateSection({ name = "Keybinds" })
    PlayerKeybind("FlyKey", "Flight Key", "Fly")
    PlayerKeybind("NoclipKey", "Noclip Key", "Noclip")
    PlayerKeybind("ThirdPersonKey", "Third Person Key", "ThirdPerson")

    ResetPlayerSettings = function()
        for Key, Control in pairs(PlayerControls) do
            Control:Set(PlayerDefaults[Key])
            PlayerSettings[Key] = PlayerDefaults[Key]
        end
    end

    PlayerTab:CreateSection({ name = "Utilities" })

    PlayerTab:CreateButton({
        name = "Reset Player Settings",
        callback = function()
            ResetPlayerSettings()

            Window:Notify({
                title = "Koda Hub",
                content = "Player settings restored to defaults.",
            })
        end,
    })
end

