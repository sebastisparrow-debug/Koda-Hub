            end
        end,
    })

    TriggerControls.AimPoint = CombatTab:CreateDropdown({
        name = "Trigger Aim Point",
        description = "Screen Center suits locked-mouse shooters. Cursor follows your mouse.",
        flag = "TriggerAimPoint",
        options = { "Screen Center", "Cursor" },
        value = TriggerSettings.AimPoint,

        callback = function(Value)
            TriggerSettings.AimPoint = Value
        end,
    })

    TriggerControls.Delay = CombatTab:CreateSlider({
        name = "Trigger Delay",
        flag = "TriggerDelay",
        range = { 0, 500 },
        increment = 10,
        suffix = " ms",
        value = TriggerSettings.Delay,

        callback = function(Value)
            TriggerSettings.Delay = Value
        end,
    })

    TriggerControls.Interval = CombatTab:CreateSlider({
