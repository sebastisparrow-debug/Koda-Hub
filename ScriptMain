local function GetESPCandidates()
    local List = {}

    if ESPSettings.TargetPlayers then
        for _, Player in ipairs(Players:GetPlayers()) do
            if Player ~= LocalPlayer and Player.Character then
                table.insert(List, Player.Character)
            end
        end
    end

    if ESPSettings.TargetNPCs then
        local Folder = GetTestFolder()

        if Folder then
            for _, Child in ipairs(Folder:GetChildren()) do
                if Child:IsA("Model") then
                    table.insert(List, Child)
                end
            end
        end
    end

    return List
end

-- returns color, isTeammate
local function GetESPColor(Model)
    local Owner = Players:GetPlayerFromCharacter(Model)

    if Owner then
        local Teammate = LocalPlayer.Team ~= nil and Owner.Team == LocalPlayer.Team

        if ESPSettings.TeamColors and Owner.Team then
            return Owner.TeamColor.Color, Teammate
        end

        return Teammate and ESPSettings.TeamColor or ESPSettings.EnemyColor, Teammate
    end

    -- NPC: "Team" attribute or StringValue, same as the aimlock
    local TargetTeam = Model:GetAttribute("Team")

    if not TargetTeam then
        local TeamValue = Model:FindFirstChild("Team")

        if TeamValue and TeamValue:IsA("StringValue") then
            TargetTeam = TeamValue.Value
        end
    end

    local Teammate = LocalPlayer.Team ~= nil
        and TargetTeam ~= nil
        and tostring(TargetTeam) == LocalPlayer.Team.Name

    return ESPSettings.NPCColor, Teammate
end

local function CreateESPEntry(Model)
    local Highlight = Instance.new("Highlight")
    Highlight.Name = "KodaChams"
    Highlight.Adornee = Model
    Highlight.Enabled = false
    Highlight.Parent = ESPHighlights

    local Billboard = Instance.new("BillboardGui")
    Billboard.Name = "KodaESPLabel"
    Billboard.AlwaysOnTop = true
    Billboard.ResetOnSpawn = false
    Billboard.Size = UDim2.fromOffset(220, 48)
    Billboard.MaxDistance = math.huge
    Billboard.Enabled = false
    Billboard.Parent = ESPGui

    local Label = Instance.new("TextLabel")
    Label.BackgroundTransparency = 1
    Label.Size = UDim2.fromScale(1, 1)
    Label.Font = Enum.Font.GothamMedium
    Label.TextStrokeTransparency = 0.4
    Label.TextStrokeColor3 = Color3.new(0, 0, 0)
    Label.TextYAlignment = Enum.TextYAlignment.Bottom
    Label.Text = ""
    Label.Parent = Billboard

    return { Highlight = Highlight, Billboard = Billboard, Label = Label }
end

local function HideESPEntry(Entry)
    Entry.Highlight.Enabled = false
    Entry.Billboard.Enabled = false
end

local function DestroyESPEntry(Entry)
    pcall(function()
        Entry.Highlight:Destroy()
    end)

    pcall(function()
        Entry.Billboard:Destroy()
    end)
end

local function ClearAllESP()
    for Model, Entry in pairs(ESPObjects) do
        DestroyESPEntry(Entry)
        ESPObjects[Model] = nil
    end
end

local function UpdateESPEntry(Model, Entry, Origin)
    local Humanoid = Model:FindFirstChildOfClass("Humanoid")
    local Root = Model:FindFirstChild("HumanoidRootPart") or Model.PrimaryPart

    if not Humanoid or Humanoid.Health <= 0 or not Root then
        HideESPEntry(Entry)
        return
    end

    local Dist = (Root.Position - Origin).Magnitude

    if Dist > ESPSettings.MaxDistance then
        HideESPEntry(Entry)
        return
    end

    local Color, Teammate = GetESPColor(Model)

    if Teammate and not ESPSettings.ShowTeammates then
        HideESPEntry(Entry)
        return
    end

    -- chams
    local Highlight = Entry.Highlight
    Highlight.Adornee = Model
    Highlight.FillColor = Color
    Highlight.OutlineColor = Color
    Highlight.FillTransparency = ESPSettings.FillPercent / 100
    Highlight.OutlineTransparency = ESPSettings.OutlinePercent / 100
    Highlight.DepthMode = ESPSettings.VisibleOnly
        and Enum.HighlightDepthMode.Occluded
        or Enum.HighlightDepthMode.AlwaysOnTop
    Highlight.Enabled = ESPSettings.Chams

    -- text
    local Lines = {}
    local Owner = Players:GetPlayerFromCharacter(Model)

    if ESPSettings.Names then
        table.insert(Lines, Owner and Owner.DisplayName or Model.Name)
    end

    local Info = {}

    if ESPSettings.Distance then
        table.insert(Info, string.format("%d studs", Dist))
    end

    if ESPSettings.Health then
        table.insert(Info, string.format("%d HP", math.max(0, math.floor(Humanoid.Health))))
    end

    if #Info > 0 then
        table.insert(Lines, table.concat(Info, "  |  "))
    end

    if #Lines == 0 then
        Entry.Billboard.Enabled = false
        return
    end

    local Head = Model:FindFirstChild("Head")
    Entry.Billboard.Adornee = Head or Root
    Entry.Billboard.StudsOffset = Vector3.new(0, Head and 2.2 or 4.2, 0)

    Entry.Label.Text = table.concat(Lines, "\n")
    Entry.Label.TextColor3 = Color
    Entry.Label.TextSize = ESPSettings.TextSize
    Entry.Billboard.Enabled = true
end

local LastESPUpdate = 0

local function UpdateESP()
    if ESPCleaned then
        return
    end

    local Now = os.clock()

    if Now - LastESPUpdate < 1 / 30 then
        return
    end

    LastESPUpdate = Now

    if not ESPSettings.Enabled then
        if next(ESPObjects) then
            ClearAllESP()
        end
        return
    end

    local Origin = GetOrigin()

    if not Origin then
        return
    end

    local Seen = {}

    for _, Model in ipairs(GetESPCandidates()) do
        Seen[Model] = true

        local Entry = ESPObjects[Model]

        if not Entry then
            Entry = CreateESPEntry(Model)
            ESPObjects[Model] = Entry
        end

        UpdateESPEntry(Model, Entry, Origin)
    end

    -- drop entries for models that left, respawned, or got filtered out
    for Model, Entry in pairs(ESPObjects) do
        if not Seen[Model] or not Model.Parent then
            DestroyESPEntry(Entry)
            ESPObjects[Model] = nil
        end
    end
end

table.insert(Connections, RunService.Heartbeat:Connect(UpdateESP))

