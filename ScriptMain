            table.insert(Compatible, Game.Name)
        end
    end

    GamesTab:CreateText({
        name = "Detected in this game",
        text = "Compatible: " .. table.concat(Compatible, ", ") .. ".",
    })

    for _, Game in ipairs(Games) do
