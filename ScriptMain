                if Down(Enum.KeyCode.W) then Direction += Look.LookVector end
                if Down(Enum.KeyCode.S) then Direction -= Look.LookVector end
                if Down(Enum.KeyCode.D) then Direction += Look.RightVector end
                if Down(Enum.KeyCode.A) then Direction -= Look.RightVector end
                if Down(Enum.KeyCode.Space) or Down(Enum.KeyCode.E) then Direction += Vector3.yAxis end
                if Down(Enum.KeyCode.LeftControl) or Down(Enum.KeyCode.Q) then Direction -= Vector3.yAxis end
            end

            if Direction.Magnitude > 0 then
                Direction = Direction.Unit * PS.FlySpeed
