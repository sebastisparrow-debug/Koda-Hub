local ResetTriggerSettings

do
    local TriggerDefaults = {
        Enabled = false,
        AimPoint = "Screen Center", -- or "Cursor"
        Delay = 0,                  -- ms the target must stay under the aim point before the first click
        Interval = 100,             -- ms between clicks while still on target
        Range = 500,                -- studs
    }

    local TriggerSettings = {}

    for key, value in pairs(TriggerDefaults) do
        TriggerSettings[key] = value
    end

    local TriggerControls = {}
    local TriggerParams = RaycastParams.new()
    TriggerParams.FilterType = Enum.RaycastFilterType.Exclude

    local TriggerSeenAt = nil
    local TriggerLastShot = 0

    -- Fires ONE left click. Uses the executor's mouse1click when it exists,
    -- otherwise falls back to VirtualInputManager at the current cursor position.
    local function TriggerClick()
        if type(mouse1click) == "function" then
            mouse1click()
            return
        end

        pcall(function()
            local VIM = game:GetService("VirtualInputManager")
            local Position = UserInputService:GetMouseLocation()

            VIM:SendMouseButtonEvent(Position.X, Position.Y, 0, true, game, 0)
            VIM:SendMouseButtonEvent(Position.X, Position.Y, 0, false, game, 0)
        end)
    end

    -- Returns the valid target model under the aim point, or nil.
    -- Walls block the ray, so it only fires at things you can actually hit.
    local function GetTriggerTarget()
        local Camera = Workspace.CurrentCamera

        if not Camera then
            return nil
        end

        local Point

        if TriggerSettings.AimPoint == "Cursor" then
            Point = UserInputService:GetMouseLocation()
        else
            Point = Camera.ViewportSize / 2
        end

        local Ray = Camera:ViewportPointToRay(Point.X, Point.Y)
        local Character = LocalPlayer.Character
        TriggerParams.FilterDescendantsInstances = Character and { Character } or {}

        local Result = Workspace:Raycast(Ray.Origin, Ray.Direction * TriggerSettings.Range, TriggerParams)

        if not Result then
            return nil
        end

        -- walk up from the part that was hit to the model that owns a Humanoid
        local Model = Result.Instance:FindFirstAncestorOfClass("Model")

        while Model and not Model:FindFirstChildOfClass("Humanoid") do
            Model = Model:FindFirstAncestorOfClass("Model")
        end

        if not Model then
            return nil
        end

        local Humanoid = Model:FindFirstChildOfClass("Humanoid")

        if not Humanoid or Humanoid.Health <= 0 then
            return nil
        end

        -- same target rules as the aimlock (Target Players / Target NPC Dummies / Team Check)
        local Owner = Players:GetPlayerFromCharacter(Model)

        if Owner then
            if Owner == LocalPlayer or not AimSettings.TargetPlayers then
                return nil
            end
        else
            local Folder = GetTestFolder()

            if not AimSettings.TargetNPCs or not Folder or Model.Parent ~= Folder then
                return nil
            end
        end

        if not PassesTeamCheck(Model) then
            return nil
        end

        return Model
    end

    local function UpdateTrigger()
        if not TriggerSettings.Enabled or UserInputService:GetFocusedTextBox() then
            TriggerSeenAt = nil
            return
        end

        if not GetTriggerTarget() then
            TriggerSeenAt = nil
            return
        end

        local Now = os.clock()

        if not TriggerSeenAt then
            TriggerSeenAt = Now
        end

        if Now - TriggerSeenAt < TriggerSettings.Delay / 1000 then
            return
        end

        if Now - TriggerLastShot < TriggerSettings.Interval / 1000 then
            return
        end

        TriggerLastShot = Now
        TriggerClick()
    end

    -- Cleanup() disconnects everything in Connections, so this stops on unload too.
    table.insert(Connections, RunService.Heartbeat:Connect(UpdateTrigger))

    ------------------ UI
    CombatTab:CreateSection({ name = "Triggerbot (Unfinished)" })

    CombatTab:CreateText({
        name = "Unfinished",
        text = "Triggerbot is unfinished. For now it only presses left click when a valid target is under your aim point. It follows the Targeting toggles and Team Check above.",
    })

    TriggerControls.Enabled = CombatTab:CreateToggle({
