BuildGame = function(Game)
    local Zombie = Game.Kind == "Zombie"
    local GameSession = NewSession()
    local Window = CreateHubWindow(Game.Name, "KodaHub_" .. Game.Id)

    -- Registered immediately, so a failed build is still cleaned up by Teardown().
    Active = { Game = Game, Session = GameSession, Window = Window }

    Prefs.LastGame = Game.Id
    SavePrefs()

    Window:CreateSection({ name = "General" })
    local HomeTab = Window:CreateTab({ name = "Home", icon = 93364949241311 })
    local PlayerTab = Window:CreateTab({ name = "Player", icon = 10686489468 })

    Window:CreateSection({ name = "Features" })
    local CombatTab = Window:CreateTab({ name = "Combat", icon = COMBAT_ICON })
    local VisualsTab = Window:CreateTab({ name = "Visuals", icon = 10686484299 })

    local ArsenalTab
    if Game.Arsenal then
        Window:CreateSection({ name = "Games" })
        ArsenalTab = Window:CreateTab({ name = "Arsenal", icon = COMBAT_ICON })
    end

    Window:CreateSection({ name = "Menu" })
    local SettingsTab = Window:CreateTab({ name = "Settings", icon = SETTINGS_ICON })

    local Resetters = {}

    --==================================================
    -- STATUS TAG
    --==================================================

    local STATUS_COLORS = {
        Idle = Color3.fromRGB(110, 118, 135),
        Ready = Color3.fromRGB(80, 200, 120),
        Locked = Color3.fromRGB(255, 75, 75),
    }

    local StatusTag, LastStatus

    pcall(function()
        StatusTag = Window:CreateTag({ text = "Idle", color = STATUS_COLORS.Idle, order = 1 })
        LastStatus = "Idle"
    end)

    local function SetStatus(Name)
        if StatusTag and Name ~= LastStatus then
            LastStatus = Name
            pcall(function() StatusTag:Set({ text = Name, color = STATUS_COLORS[Name] }) end)
        end
    end

    --==================================================
    -- COMBAT + VISUALS SETTINGS  (aimlock / ESP logic is unchanged)
    --==================================================

    local Defaults = {
        -- aimlock
        Enabled = false,
        AimKey = Enum.UserInputType.MouseButton2,
        AimMode = "Hold",
        TargetPart = "Head",
        LockStrength = 100,
        StickyLock = true,
        FOV = 150,
        MaxDistance = 1000,
        WallCheck = false,
        ShowFOV = true,
        -- targets
        TeamCheck = true,
        TargetBots = true,
        TargetZombiePlayers = true,
        -- esp
        ESP = false,
        Chams = true,
        Names = true,
        Distance = true,
        Health = true,
        -- triggerbot (unfinished)
        TriggerEnabled = false,
        TriggerAimPoint = "Screen Center",
        TriggerDelay = 0,
        TriggerInterval = 100,
        TriggerRange = 500,
    }

    local Cfg = GetStore(Game.Id .. ":Combat", Defaults)
    Cfg.Enabled = false
    Cfg.ESP = false
    Cfg.TriggerEnabled = false

    local AimHeld, AimToggled = false, false
    local Target, TargetPart, Locked = nil, nil, false

    local function ClearTarget()
        Target, TargetPart, Locked = nil, nil, false
    end

    --------------------------------------------------
    -- Target rules (the only part that differs per game)
    --------------------------------------------------

    local function GetCandidates()
        local List = {}

        if Zombie then
            if Cfg.TargetBots then
                local Bots = Workspace:FindFirstChild("Bots")

                if Bots then
                    for _, Child in ipairs(Bots:GetChildren()) do
                        if Child:IsA("Model") then
                            table.insert(List, Child)
                        end
                    end
                end
            end

            if Cfg.TargetZombiePlayers then
                for _, Player in ipairs(Players:GetPlayers()) do
                    if Player ~= LocalPlayer and Player.Character
                        and Player.Team and Player.Team.Name == "Zombies" then
                        table.insert(List, Player.Character)
                    end
                end
            end
        else
            for _, Player in ipairs(Players:GetPlayers()) do
                if Player ~= LocalPlayer and Player.Character then
                    if not (Cfg.TeamCheck and LocalPlayer.Team and Player.Team == LocalPlayer.Team) then
                        table.insert(List, Player.Character)
                    end
                end
            end
        end

        return List
    end

    local function IsTarget(Model)
        local Owner = Players:GetPlayerFromCharacter(Model)

        if Zombie then
            if Owner then
                return Cfg.TargetZombiePlayers and Owner ~= LocalPlayer
                    and Owner.Team ~= nil and Owner.Team.Name == "Zombies"
            end

            local Bots = Workspace:FindFirstChild("Bots")
            return Cfg.TargetBots and Bots ~= nil and Model.Parent == Bots
        end

        if not Owner or Owner == LocalPlayer then
            return false
        end

        return not (Cfg.TeamCheck and LocalPlayer.Team and Owner.Team == LocalPlayer.Team)
    end

    local function GetPart(Model)
        local Name = Cfg.TargetPart
        local Part = Model:FindFirstChild(Name)

        if not Part and Name == "UpperTorso" then
            Part = Model:FindFirstChild("Torso") -- R6
        end

        Part = Part or Model:FindFirstChild("HumanoidRootPart") or Model.PrimaryPart

        return Part and Part:IsA("BasePart") and Part or nil
    end

    local function GetOrigin()
        local Char = LocalPlayer.Character
        local Root = Char and Char:FindFirstChild("HumanoidRootPart")

        if Root then
            return Root.Position
        end

        local Camera = Workspace.CurrentCamera
        return Camera and Camera.CFrame.Position or nil
    end

    local RayParams = RaycastParams.new()
    RayParams.FilterType = Enum.RaycastFilterType.Exclude

    local function CanSee(Model, Part)
        if not Cfg.WallCheck then
            return true
        end

        local Camera = Workspace.CurrentCamera
        if not Camera then
            return false
        end

        local Char = LocalPlayer.Character
        RayParams.FilterDescendantsInstances = Char and { Char } or {}

        local Origin = Camera.CFrame.Position
        local Hit = Workspace:Raycast(Origin, Part.Position - Origin, RayParams)

        return Hit == nil or Hit.Instance:IsDescendantOf(Model)
    end

    local function Validate(Model)
        if not Model.Parent then
            return nil
        end

        local Humanoid = Model:FindFirstChildOfClass("Humanoid")
        if not Humanoid or Humanoid.Health <= 0 then
            return nil
        end

        local Part, Origin = GetPart(Model), GetOrigin()
        if not Part or not Origin then
            return nil
        end

        if (Part.Position - Origin).Magnitude > Cfg.MaxDistance then
            return nil
        end

        if not CanSee(Model, Part) then
            return nil
        end

        return Part
    end

    local function ToScreen(Part)
        local Camera = Workspace.CurrentCamera
        if not Camera then
            return nil, false
        end

        local P, OnScreen = Camera:WorldToViewportPoint(Part.Position)
        return Vector2.new(P.X, P.Y), OnScreen and P.Z > 0
    end

    local function GetClosest()
        local Mouse = UserInputService:GetMouseLocation()
        local Best, BestModel, BestPart = Cfg.FOV, nil, nil

        for _, Model in ipairs(GetCandidates()) do
            local Part = Validate(Model)

            if Part then
                local Pos, OnScreen = ToScreen(Part)

                if OnScreen then
                    local Dist = (Pos - Mouse).Magnitude

                    if Dist <= Best then
                        Best, BestModel, BestPart = Dist, Model, Part
                    end
                end
            end
        end

        return BestModel, BestPart
    end

