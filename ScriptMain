        flag = "TriggerInterval",
        range = { 50, 1000 },
        increment = 10,
        suffix = " ms",
        value = TriggerSettings.Interval,

        callback = function(Value)
            TriggerSettings.Interval = Value
        end,
    })

    TriggerControls.Range = CombatTab:CreateSlider({
        name = "Trigger Range",
        flag = "TriggerRange",
        range = { 50, 2000 },
        increment = 50,
        suffix = " studs",
        value = TriggerSettings.Range,

        callback = function(Value)
