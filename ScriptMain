local Cleaned = false

Cleanup = function()
    if Cleaned then
        return
    end

    Cleaned = true

    pcall(function()
        RunService:UnbindFromRenderStep(BIND_NAME)
    end)

    for _, Connection in ipairs(Connections) do
        pcall(function()
            Connection:Disconnect()
        end)
    end

    table.clear(Connections)

    pcall(ESPCleanup)
    pcall(PlayerCleanup)

    if Overlay then
        Overlay:Destroy()
    end

    if not Window.unloaded then
        pcall(function()
            Window:Unload()
        end)
    end
end

Env.KodaHubCleanup = Cleanup

