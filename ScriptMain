local function NormalizeKey(Key)
    if typeof(Key) == "EnumItem" then
        return Key
    end

    if type(Key) == "string" then
        local Ok, Item = pcall(function()
            return Enum.KeyCode[Key]
        end)

        if Ok and Item then
            return Item
        end

        Ok, Item = pcall(function()
            return Enum.UserInputType[Key]
        end)

        if Ok and Item then
            return Item
        end
    end

    return nil
end

local function MatchesAimKey(Input)
    local Key = AimSettings.AimKey

    if not Key then
        return false
    end

    return Input.KeyCode == Key or Input.UserInputType == Key
end

table.insert(Connections, UserInputService.InputBegan:Connect(function(Input)
    if UserInputService:GetFocusedTextBox() then
        return
    end

    if MatchesAimKey(Input) then
        TargetLocked = false -- every press starts a fresh lock

        if AimSettings.AimOnHold then
            AimHeld = true
        else
            AimToggleActive = not AimToggleActive
        end
    end
end))

table.insert(Connections, UserInputService.InputEnded:Connect(function(Input)
    if MatchesAimKey(Input) and AimSettings.AimOnHold then
        AimHeld = false
        TargetLocked = false
    end
end))

local function IsAimActive()
    if not AimSettings.Enabled then
        return false
    end

    if AimSettings.AimOnHold then
        return AimHeld
    end

    return AimToggleActive
end

