--==================================================
-- TARGET HELPERS
--==================================================

local function ClearTarget()
    CurrentTarget = nil
    CurrentTargetPart = nil
    TargetLocked = false
end

local function GetTestFolder()
    return Workspace:FindFirstChild(TEST_FOLDER_NAME)
end

-- Every model we are allowed to aim at: other players + NPC test dummies.
local function GetCandidates()
    local List = {}

    if AimSettings.TargetPlayers then
        for _, Player in ipairs(Players:GetPlayers()) do
            local Character = Player.Character

            if Player ~= LocalPlayer and Character then
                table.insert(List, Character)
            end
        end
    end

    if AimSettings.TargetNPCs then
        local Folder = GetTestFolder()

        if Folder then
            for _, Child in ipairs(Folder:GetChildren()) do
                if Child:IsA("Model") then
                    table.insert(List, Child)
                end
            end
        end
    end

    return List
end

local function GetTargetPart(Model)
    local Name = AimSettings.TargetPart
    local Part = Model:FindFirstChild(Name)

    -- R6 rigs have no UpperTorso
    if not Part and Name == "UpperTorso" then
        Part = Model:FindFirstChild("Torso")
    end

    if not Part and Name == "HumanoidRootPart" then
        Part = Model.PrimaryPart
    end

    if not Part then
        Part = Model:FindFirstChild(Name, true)
    end

    -- last resort so the lock never silently fails on odd rigs
    if not Part then
        Part = Model:FindFirstChild("HumanoidRootPart") or Model.PrimaryPart
    end

    if Part and Part:IsA("BasePart") then
        return Part
    end

    return nil
end

local function IsAlive(Model)
    local Humanoid = Model:FindFirstChildOfClass("Humanoid")

    if not Humanoid then
        return false
    end

    if AimSettings.AliveCheck and Humanoid.Health <= 0 then
        return false
    end

    return true
end

local function PassesTeamCheck(Model)
    if not AimSettings.TeamCheck then
        return true
    end

    local Owner = Players:GetPlayerFromCharacter(Model)

    if Owner then
        local MyTeam = LocalPlayer.Team

        -- no teams in the game (or you are neutral) means everyone is fair game
        return MyTeam == nil or Owner.Team ~= MyTeam
    end

    -- NPCs: "Team" attribute or a StringValue called "Team"
    local TargetTeam = Model:GetAttribute("Team")

    if not TargetTeam then
        local TeamValue = Model:FindFirstChild("Team")

        if TeamValue and TeamValue:IsA("StringValue") then
            TargetTeam = TeamValue.Value
        end
    end

    if LocalPlayer.Team and TargetTeam then
        if tostring(TargetTeam) == LocalPlayer.Team.Name then
            return false
        end
    end

    return true
end

local RayParams = RaycastParams.new()
RayParams.FilterType = Enum.RaycastFilterType.Exclude

local function HasLineOfSight(Model, Part)
    if not AimSettings.LineOfSight then
        return true
    end

    local Camera = Workspace.CurrentCamera

    if not Camera then
        return false
    end

    local Character = LocalPlayer.Character
    RayParams.FilterDescendantsInstances = Character and { Character } or {}

    local Origin = Camera.CFrame.Position
    local Result = Workspace:Raycast(Origin, Part.Position - Origin, RayParams)

    return Result == nil or Result.Instance:IsDescendantOf(Model)
end

local function GetOrigin()
    local Character = LocalPlayer.Character
    local Root = Character and Character:FindFirstChild("HumanoidRootPart")

    if Root and Root:IsA("BasePart") then
        return Root.Position
    end

    local Camera = Workspace.CurrentCamera

    return Camera and Camera.CFrame.Position or nil
end

local function GetScreenPosition(Part)
    local Camera = Workspace.CurrentCamera

    if not Camera then
        return nil, false
    end

    local Point, OnScreen = Camera:WorldToViewportPoint(Part.Position)

    return Vector2.new(Point.X, Point.Y), OnScreen and Point.Z > 0
end

-- Alive / team / distance checks shared by target acquisition and lock validation.
local function GetCandidatePart(Model)
    if not Model.Parent then
        return nil
    end

    if not IsAlive(Model) or not PassesTeamCheck(Model) then
        return nil
    end

    local Part = GetTargetPart(Model)
    local Origin = GetOrigin()

    if not Part or not Origin then
        return nil
    end

    if (Part.Position - Origin).Magnitude > AimSettings.MaxDistance then
        return nil
    end

    return Part
end

-- Closest eligible target to the cursor, inside the FOV circle.
local function GetClosestTarget()
    local MousePosition = UserInputService:GetMouseLocation()
    local BestDistance = AimSettings.FOV
    local BestModel = nil
    local BestPart = nil

    for _, Model in ipairs(GetCandidates()) do
        local Part = GetCandidatePart(Model)

        if Part then
            local ScreenPosition, OnScreen = GetScreenPosition(Part)

            if OnScreen and ScreenPosition then
                local ScreenDistance = (ScreenPosition - MousePosition).Magnitude

                -- raycast last, only for a target that would actually win
                if ScreenDistance <= BestDistance and HasLineOfSight(Model, Part) then
                    BestDistance = ScreenDistance
                    BestModel = Model
                    BestPart = Part
                end
            end
        end
    end

    return BestModel, BestPart
end

-- A locked target stays locked even if it leaves the FOV circle,
-- but it is dropped the moment it dies, leaves, or breaks a check.
local function ValidateLockedTarget(Model)
    local Part = GetCandidatePart(Model)

    if Part and HasLineOfSight(Model, Part) then
        return Part
    end

    return nil
end

