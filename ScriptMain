    local TriggerParams = RaycastParams.new()
    TriggerParams.FilterType = Enum.RaycastFilterType.Exclude

    local TriggerSeenAt, TriggerLastShot = nil, 0

    local function TriggerClick()
        if type(mouse1click) == "function" then
            mouse1click()
            return
        end

        pcall(function()
            local VIM = game:GetService("VirtualInputManager")
            local Pos = UserInputService:GetMouseLocation()

            VIM:SendMouseButtonEvent(Pos.X, Pos.Y, 0, true, game, 0)
            VIM:SendMouseButtonEvent(Pos.X, Pos.Y, 0, false, game, 0)
        end)
    end

    local function GetTriggerTarget()
        local Camera = Workspace.CurrentCamera
        if not Camera then
            return nil
        end

        local Point = Cfg.TriggerAimPoint == "Cursor"
            and UserInputService:GetMouseLocation()
            or Camera.ViewportSize / 2

        local Ray = Camera:ViewportPointToRay(Point.X, Point.Y)
        local Char = LocalPlayer.Character
        TriggerParams.FilterDescendantsInstances = Char and { Char } or {}

        local Result = Workspace:Raycast(Ray.Origin, Ray.Direction * Cfg.TriggerRange, TriggerParams)
        if not Result then
            return nil
        end

        local Model = Result.Instance:FindFirstAncestorOfClass("Model")

        while Model and not Model:FindFirstChildOfClass("Humanoid") do
            Model = Model:FindFirstAncestorOfClass("Model")
        end

        if not Model then
            return nil
        end

        local Humanoid = Model:FindFirstChildOfClass("Humanoid")

        if not Humanoid or Humanoid.Health <= 0 or not IsTarget(Model) then
            return nil
        end

        return Model
    end

    GameSession:Connect(RunService.Heartbeat, function()
        if not Cfg.TriggerEnabled or UserInputService:GetFocusedTextBox() then
            TriggerSeenAt = nil
            return
        end

        if not GetTriggerTarget() then
            TriggerSeenAt = nil
            return
        end

        local Now = os.clock()
        TriggerSeenAt = TriggerSeenAt or Now

        if Now - TriggerSeenAt < Cfg.TriggerDelay / 1000 then
            return
        end

        if Now - TriggerLastShot < Cfg.TriggerInterval / 1000 then
            return
        end

        TriggerLastShot = Now
        TriggerClick()
    end)

