        local FIRE_RATE_LOWER_IS_FASTER = true

        local ArsenalDefaults = {
            Enabled = false,
            InfiniteAmmo = true,
            InstantReload = true,
            FastEquip = false,
            FullAuto = true,
            FireRateMult = 1,
            RecoilPercent = 100,
            SpreadPercent = 100,
            DamagePercent = 100,
            RangePercent = 100,
            FalloffPercent = 100,
            BulletPercent = 100,
        }

        local AS = GetStore(Game.Id .. ":Gun", ArsenalDefaults)
        AS.Enabled = false

        local Originals = setmetatable({}, { __mode = "k" })
        local Dirty, GunDead, LastReconcile = true, false, 0

        local function GetWeapons()
            return ReplicatedStorage:FindFirstChild("Weapons")
        end

        local function SetStat(Object, Wanted)
            local Class = Object.ClassName

            if Class == "BoolValue" then
                local Bool = Wanted == true or (type(Wanted) == "number" and Wanted ~= 0)

                if Object.Value ~= Bool then
                    Object.Value = Bool
                end
            elseif Class == "NumberValue" or Class == "IntValue" then
                local Number = Wanted

                if type(Number) == "boolean" then
                    Number = Number and 1 or 0
                end

                if Class == "IntValue" then
                    Number = math.floor(Number + 0.5)
                end

                if Object.Value ~= Number then
                    Object.Value = Number
                end
            end
        end

        local function Percent(Value)
            if Value ~= 100 then
                return Value / 100
            end

            return nil
        end

        local Scale = {
            FireRate = {
                Min = 0.01,
                Factor = function()
                    if AS.FireRateMult <= 1 then
                        return nil
                    end

                    return FIRE_RATE_LOWER_IS_FASTER and (1 / AS.FireRateMult) or AS.FireRateMult
                end,
            },
            RecoilControl = { Factor = function() return Percent(AS.RecoilPercent) end },
            Spread = { Factor = function() return Percent(AS.SpreadPercent) end },
            MaxSpread = { Factor = function() return Percent(AS.SpreadPercent) end },
            DMG = { Factor = function() return Percent(AS.DamagePercent) end },
            Range = { Factor = function() return Percent(AS.RangePercent) end },
            Falloff = { Factor = function() return Percent(AS.FalloffPercent) end },
            Bullets = { Min = 1, Factor = function() return Percent(AS.BulletPercent) end },
        }

        local function Desired(Name, Original)
            if not AS.Enabled then
                return nil
            end

            if (Name == "Ammo" or Name == "StoredAmmo") and AS.InfiniteAmmo then
                return AMMO_FILL
            end

            if Name == "ReloadTime" and AS.InstantReload then
                return MIN_TIME
            end

            if Name == "EquipTime" and AS.FastEquip then
                return MIN_TIME
            end

            if Name == "Auto" and AS.FullAuto then
                return true
            end

            local Rule = Scale[Name]

            if Rule and type(Original) == "number" then
                local Factor = Rule.Factor()

                if Factor then
                    local Result = Original * Factor

                    if Rule.Min then
                        Result = math.max(Rule.Min, Result)
                    end

                    return Result
                end
            end

            return nil
        end

        local function Reconcile()
            local Folder = GetWeapons()
            if not Folder then
                return
            end

            for _, Gun in ipairs(Folder:GetChildren()) do
                for _, Stat in ipairs(Gun:GetChildren()) do
                    if Stat:IsA("ValueBase") then
                        local Stored = Originals[Stat]
                        local Original = Stored

                        if Original == nil then
                            Original = Stat.Value
                        end

                        local Wanted = Desired(Stat.Name, Original)

                        if Wanted ~= nil then
                            if Stored == nil then
                                Originals[Stat] = Original
                            end

                            SetStat(Stat, Wanted)
                        elseif Stored ~= nil then
                            SetStat(Stat, Stored)
                            Originals[Stat] = nil
                        end
                    end
                end
            end
        end

        GameSession:Connect(RunService.Heartbeat, function()
            if GunDead then
                return
            end

            local Now = os.clock()

            if not Dirty and Now - LastReconcile < 0.5 then
                return
            end

            Dirty = false
            LastReconcile = Now

            if AS.Enabled or next(Originals) then
                pcall(Reconcile)
            end
        end)

        GameSession:OnCleanup(function()
            GunDead = true
            AS.Enabled = false
            pcall(Reconcile) -- puts every stat back
        end)

        local GunUI = MakeUI(ArsenalTab, AS, Game.Id .. "_Gun_", function(Key, Value, Different)
            Dirty = true

            if Key == "Enabled" and Different then
                Toast(Window, "Gun Mods", Value and "Enabled - re-equip your gun" or "Disabled")
            end
        end)

        local function PrintWeaponStats()
            local Folder = GetWeapons()

            if not Folder then
                Window:Notify({ title = "Arsenal", content = "ReplicatedStorage.Weapons was not found. Join Arsenal first." })
                return
            end

            local Lines = {}

            for _, Gun in ipairs(Folder:GetChildren()) do
                local Parts = {}

                for _, Stat in ipairs(Gun:GetChildren()) do
                    if Stat:IsA("NumberValue") or Stat:IsA("IntValue") or Stat:IsA("BoolValue") then
                        local Text = Stat.Name .. "=" .. tostring(Stat.Value)

                        if Originals[Stat] ~= nil then
                            Text = Text .. " (orig " .. tostring(Originals[Stat]) .. ")"
                        end

                        table.insert(Parts, Text)
                    end
                end

                table.sort(Parts)
                table.insert(Lines, Gun.Name .. ": " .. table.concat(Parts, ", "))
            end

            table.sort(Lines)
            print("[Koda Hub] Weapon stats (" .. #Lines .. " guns)\n" .. table.concat(Lines, "\n"))
            Window:Notify({ title = "Arsenal", content = "Printed " .. #Lines .. " guns to the developer console (F9)." })
        end

        ArsenalTab:CreateSection({ name = "Status" })

        local Folder = GetWeapons()
        local GunCount = Folder and #Folder:GetChildren() or 0

        ArsenalTab:CreateText({
            name = GunCount > 0 and ("Weapons found: " .. GunCount) or "Weapons folder not found",
            text = GunCount > 0
                and "Client side only. Changes apply to your local copy of ReplicatedStorage.Weapons, so re-equip a gun after changing anything."
                or "Join Arsenal and switch to this game again. Nothing here does anything until ReplicatedStorage.Weapons exists.",
        })

        ArsenalTab:CreateSection({ name = "Gun Mods" })
        GunUI.Toggle("Enabled", "Enable Gun Mods", "Master switch. Turning it off restores every original stat. Always starts off.", true)
        GunUI.Toggle("InfiniteAmmo", "Infinite Ammo", "Sets Ammo and StoredAmmo to " .. AMMO_FILL .. " on every gun.")
        GunUI.Toggle("InstantReload", "Instant Reload", "ReloadTime drops to " .. MIN_TIME .. "s.")
        GunUI.Toggle("FastEquip", "Fast Equip", "EquipTime drops to " .. MIN_TIME .. "s.")
        GunUI.Toggle("FullAuto", "Full Auto", "Sets Auto to true on every gun.")

        ArsenalTab:CreateSection({ name = "Fire Rate & Accuracy" })
        GunUI.Slider("FireRateMult", "Fire Rate Multiplier", { 1, 10 }, 0.5, "x", "1x leaves it alone.")
        GunUI.Slider("RecoilPercent", "Recoil", { 0, 100 }, 5, "%", "100% leaves it alone, 0% is none.")
        GunUI.Slider("SpreadPercent", "Spread", { 0, 100 }, 5, "%", "100% leaves it alone, 0% is a laser.")

        ArsenalTab:CreateSection({ name = "Damage & Range (server may ignore)" })
        GunUI.Slider("DamagePercent", "Damage", { 100, 1000 }, 25, "%", "100% leaves it alone.")
        GunUI.Slider("RangePercent", "Range", { 100, 1000 }, 25, "%", "100% leaves it alone.")
        GunUI.Slider("FalloffPercent", "Damage Falloff", { 0, 300 }, 10, "%", "Scales the Falloff stat.")
        GunUI.Slider("BulletPercent", "Bullets Per Shot", { 100, 1000 }, 50, "%", "Scales Bullets (pellets).")

        ArsenalTab:CreateSection({ name = "Utilities" })
        ArsenalTab:CreateButton({ name = "Print All Weapon Stats", callback = PrintWeaponStats })
        ArsenalTab:CreateButton({
            name = "Restore Original Stats",
            callback = function()
                GunUI.All.Enabled:Set(false)
                Dirty = true
                Window:Notify({ title = "Arsenal", content = "Original weapon stats restored." })
            end,
        })
        ArsenalTab:CreateButton({
            name = "Reset Arsenal Settings",
            callback = function()
                GunUI.Reset(ArsenalDefaults)
                Dirty = true
                Window:Notify({ title = "Koda Hub", content = "Arsenal settings restored to defaults." })
            end,
        })

        Resetters.Arsenal = function()
            GunUI.Reset(ArsenalDefaults)
            Dirty = true
        end
    end

    --==================================================
    -- HOME + SETTINGS
    --==================================================

    BuildHome(Window, HomeTab, {
        Welcome = "You are in " .. Game.Name .. ". Combat has the aimlock, Visuals has the ESP, Player has movement tools, and Settings controls the menu.",
        Extra = function(Row)
            Row:CreateButton({ name = "Open Combat", callback = function() Window:Navigate(CombatTab) end })
            Row:CreateButton({ name = "Open Visuals", callback = function() Window:Navigate(VisualsTab) end })
        end,
    })

    HomeTab:CreateSection({ name = "Games" })

    local GameRow = HomeTab:CreateGroup()
    GameRow:CreateButton({ name = "Switch Game", callback = function() SwitchTo(nil) end })
    GameRow:CreateButton({ name = "Unload Game", callback = function() UnloadToSelector() end })

    BuildSettings(Window, SettingsTab, {
        InGame = true,
        OnReset = function()
            for _, Reset in pairs(Resetters) do
                pcall(Reset)
            end
        end,
    })

    --==================================================
    -- MAIN LOOP
    --==================================================

    local function OnRenderStep(Delta)
        if Window.unloaded then
            -- The player closed the menu with the window's own controls.
            task.defer(ExitHub)
            return
        end

        local Active = AimActive()
        local Mouse = UserInputService:GetMouseLocation()

        Circle.Position = UDim2.fromOffset(Mouse.X, Mouse.Y)
        Circle.Size = UDim2.fromOffset(Cfg.FOV * 2, Cfg.FOV * 2)
        Circle.Visible = Cfg.ShowFOV and Cfg.Enabled

        if not Cfg.Enabled then
            ClearTarget()
            SetStatus("Idle")
            return
        end

        local Kept = false

        if Active and Cfg.StickyLock and Locked and Target then
            local Part = Validate(Target)

            if Part then
                TargetPart = Part
                Kept = true
            else
                ClearTarget()
            end
        end

        if not Kept then
            Target, TargetPart = GetClosest()
            Locked = Active and Target ~= nil
        end

        SetStatus(Active and Locked and "Locked" or "Ready")

        if not (Active and Target and TargetPart) then
            return
        end

        local Camera = Workspace.CurrentCamera
        if not Camera then
            return
        end

        local Strength = math.clamp(Cfg.LockStrength / 100, 0.01, 1)
        local Goal = CFrame.lookAt(Camera.CFrame.Position, TargetPart.Position)

        if Strength >= 1 then
            Camera.CFrame = Goal
        else
            local Alpha = 1 - (1 - Strength) ^ (math.min(Delta, 0.1) * 60)
            Camera.CFrame = Camera.CFrame:Lerp(Goal, Alpha)
        end
    end

    pcall(function() RunService:UnbindFromRenderStep(BIND_NAME) end)
    RunService:BindToRenderStep(BIND_NAME, Enum.RenderPriority.Camera.Value + 1, OnRenderStep)

    GameSession:OnCleanup(function()
        RunService:UnbindFromRenderStep(BIND_NAME)
        ClearESP()
        pcall(function() ESPGui:Destroy() end)
        pcall(function() ESPFolder:Destroy() end)
        pcall(function() Overlay:Destroy() end)
    end)

    HomeTab:Select(true)

    Window:Notify({
        title = "Koda Hub " .. UPDATE.version,
        content = Game.Name .. " loaded. Hold your aim key to lock on.",
    })
end

