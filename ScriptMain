--==================================================
-- LIVE UPDATE LOOP
--==================================================

local function UpdateTarget(Active)
    if not AimSettings.Enabled then
        ClearTarget()
        return
    end

    -- Sticky lock: keep the current target while the key is down.
    if Active and AimSettings.StickyLock and TargetLocked and CurrentTarget then
        local Part = ValidateLockedTarget(CurrentTarget)

        if Part then
            CurrentTargetPart = Part
            return
        end

        ClearTarget()
    end

    -- Otherwise pick the closest target to the cursor. Before the key is
    -- pressed this is only a preview; once active it becomes the lock.
    CurrentTarget, CurrentTargetPart = GetClosestTarget()
    TargetLocked = Active and CurrentTarget ~= nil
end

local function UpdateVisuals(MousePosition)
    FOVCircle.Position = UDim2.fromOffset(MousePosition.X, MousePosition.Y)
    FOVCircle.Size = UDim2.fromOffset(AimSettings.FOV * 2, AimSettings.FOV * 2)
    FOVCircle.Visible = AimSettings.ShowFOV and AimSettings.Enabled

    if CurrentTarget and CurrentTargetPart and AimSettings.ShowTarget then
        local ScreenPosition, OnScreen = GetScreenPosition(CurrentTargetPart)

        if OnScreen and ScreenPosition then
            TargetMarker.Position = UDim2.fromOffset(ScreenPosition.X, ScreenPosition.Y)
            MarkerStroke.Color = TargetLocked and LOCKED_COLOR or PREVIEW_COLOR

            local Owner = Players:GetPlayerFromCharacter(CurrentTarget)
            TargetName.Text = Owner and Owner.DisplayName or CurrentTarget.Name
            TargetName.Visible = AimSettings.ShowTargetName

            TargetMarker.Visible = true
            return
        end
    end

    TargetMarker.Visible = false
    TargetName.Visible = false
end

local function OnRenderStep(DeltaTime)
    if Window.unloaded then
        Cleanup()
        return
    end

    local Active = IsAimActive()

    UpdateTarget(Active)
    UpdateVisuals(UserInputService:GetMouseLocation())

    -- header status pill: Idle (aimlock off) / Ready (on) / Locked (on a target)
    if not AimSettings.Enabled then
        SetStatus("Idle")
    elseif Active and TargetLocked then
        SetStatus("Locked")
    else
        SetStatus("Ready")
    end

    if not (Active and CurrentTarget and CurrentTargetPart) then
        return
    end

    local Camera = Workspace.CurrentCamera

    if not Camera then
        return
    end

    local Strength = math.clamp(AimSettings.LockStrength / 100, 0.01, 1)
    local Goal = CFrame.lookAt(Camera.CFrame.Position, CurrentTargetPart.Position)

    if Strength >= 1 then
        -- hard lock: snap straight onto the target
        Camera.CFrame = Goal
    else
        -- frame-rate independent smoothing (same feel at 30 / 60 / 144 FPS)
        local Alpha = 1 - (1 - Strength) ^ (math.min(DeltaTime, 0.1) * 60)

        Camera.CFrame = Camera.CFrame:Lerp(Goal, Alpha)
    end
end

-- Bound just after the default camera so our CFrame is the last word each frame.
pcall(function()
    RunService:UnbindFromRenderStep(BIND_NAME)
end)

RunService:BindToRenderStep(BIND_NAME, Enum.RenderPriority.Camera.Value + 1, OnRenderStep)

