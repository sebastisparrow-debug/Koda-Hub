local function Unwrap(Value)
    if type(Value) == "table" then
        return Value[1]
    end

    return Value
end

local function NormalizeKey(Key)
    if typeof(Key) == "EnumItem" then
        return Key
    end

    if type(Key) == "string" then
        local Ok, Item = pcall(function() return Enum.KeyCode[Key] end)
        if Ok and Item then return Item end

        Ok, Item = pcall(function() return Enum.UserInputType[Key] end)
        if Ok and Item then return Item end
    end

    return nil
end

local function Toast(Window, Title, Subtitle)
    if not Prefs.Toasts then
        return
    end

    pcall(function()
        Window:Toast({ title = Title, subtitle = Subtitle, duration = 2 })
    end)
end

local function Confirm(Window, Title, Content, ButtonText, OnConfirm)
    pcall(function()
        Window:Popup({
            title = Title,
            content = Content,
            options = {
                { text = "Cancel" },
                { text = ButtonText, style = "danger", callback = OnConfirm },
            },
        })
    end)
end

-- Builds labeled controls that write into a settings table and can reset to defaults.
local function MakeUI(Tab, Cfg, Prefix, OnChange)
    local UI = { All = {} }

    local function Changed(Key, Value, Different)
        if OnChange then
            OnChange(Key, Value, Different)
        end
    end

    function UI.Toggle(Key, Name, Description, DontSave)
        UI.All[Key] = Tab:CreateToggle({
            name = Name,
            description = Description,
            flag = Prefix .. Key,
            value = Cfg[Key],
            forgetState = DontSave == true,
            callback = function(Value)
                local Different = Value ~= Cfg[Key]
                Cfg[Key] = Value
                Changed(Key, Value, Different)
            end,
        })
    end

    function UI.Slider(Key, Name, Range, Step, Suffix, Description)
        UI.All[Key] = Tab:CreateSlider({
            name = Name,
            description = Description,
            flag = Prefix .. Key,
            range = Range,
            increment = Step,
            suffix = Suffix,
            value = Cfg[Key],
            callback = function(Value)
                local Different = Value ~= Cfg[Key]
                Cfg[Key] = Value
                Changed(Key, Value, Different)
            end,
        })
    end

    function UI.Dropdown(Key, Name, Options, Description)
        UI.All[Key] = Tab:CreateDropdown({
            name = Name,
            description = Description,
            flag = Prefix .. Key,
            options = Options,
            value = Cfg[Key],
            callback = function(Value)
                local Item = Unwrap(Value)
                local Different = Item ~= Cfg[Key]
                Cfg[Key] = Item
                Changed(Key, Item, Different)
            end,
        })
    end

    function UI.Keybind(Key, Name, Description, Action)
        UI.All[Key] = Tab:CreateKeybind({
            name = Name,
            description = Description,
            flag = Prefix .. Key,
            value = Cfg[Key],
            callback = Action or function() end,
            onChanged = function(NewKey)
                Cfg[Key] = NormalizeKey(NewKey) or Cfg[Key]
                Changed(Key, Cfg[Key], true)
            end,
        })
    end

    function UI.Reset(Defaults)
        for Key, Control in pairs(UI.All) do
            pcall(function() Control:Set(Defaults[Key]) end)
            Cfg[Key] = Defaults[Key]
        end
    end

    return UI
end

